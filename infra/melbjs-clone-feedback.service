# ~/.config/systemd/user/melbjs-clone-feedback.service
[Unit]
Description=melbjs-clone audience feedback, files GitHub issues
After=network-online.target

[Service]
EnvironmentFile=%h/.config/melbjs-clone/env
ExecStart=/usr/bin/node /srv/melbjs-clone/server/feedback.mjs
Restart=on-failure
RestartSec=5s

[Install]
WantedBy=default.target
